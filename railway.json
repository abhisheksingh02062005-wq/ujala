{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r artifacts/ujala-bot/requirements.txt"
  },
  "deploy": {
    "startCommand": "cd artifacts/ujala-bot && python3 bot.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
